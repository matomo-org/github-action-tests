{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_body_markdown",
    "diagnostics_markdown",
    "highest_severity",
    "findings",
    "inline_comments",
    "unplaced_findings"
  ],
  "properties": {
    "review_body_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "diagnostics_markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60000,
      "pattern": "\\S"
    },
    "highest_severity": {
      "type": "string",
      "enum": ["none", "low", "medium", "blocking"]
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "medium", "low_polish"],
      "properties": {
        "blocking": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "medium": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "low_polish": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "inline_comments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "side", "severity", "body", "rule_source"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "type": "string",
            "enum": ["LEFT", "RIGHT"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "blocking"]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          },
          "rule_source": {
            "type": ["string", "null"],
            "maxLength": 128
          }
        }
      }
    },
    "unplaced_findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "comment": "path and line are optional: unplaced findings are precisely those that do not map to a diff line. This matches validateReview in post-review.js, which accepts them absent or null.",
        "required": ["severity", "body"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "blocking"]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          },
          "path": {
            "type": ["string", "null"],
            "maxLength": 1024
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    }
  }
}
